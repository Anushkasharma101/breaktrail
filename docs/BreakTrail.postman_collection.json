{
  "info": {
    "name": "BreakTrail Local API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Local single-profile API. Run Generate AI plan before requests using plan variables. Last two requests replace/delete saved data."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api"
    },
    {
      "key": "planId",
      "value": ""
    },
    {
      "key": "planJson",
      "value": "{}"
    },
    {
      "key": "historyId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health",
        "header": []
      }
    },
    {
      "name": "Ollama readiness",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/ollama/status",
        "header": []
      }
    },
    {
      "name": "Places",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/places",
        "header": []
      }
    },
    {
      "name": "Place details",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/places/neighbourhood",
        "header": []
      }
    },
    {
      "name": "Read preferences",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/preferences",
        "header": []
      }
    },
    {
      "name": "Save preferences",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/preferences",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Anushka\",\n  \"area\": \"Central Jaipur\",\n  \"minutes\": 20,\n  \"mood\": \"Quiet\",\n  \"budget\": \"Free\",\n  \"request\": \"A calm outdoor break\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Generate AI plan",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/plans",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"area\": \"Central Jaipur\",\n  \"minutes\": 20,\n  \"mood\": \"Quiet\",\n  \"budget\": \"Free\",\n  \"request\": \"A calm outdoor break\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) { const plan = pm.response.json().plan; pm.collectionVariables.set(\"planId\", plan.id); pm.collectionVariables.set(\"planJson\", JSON.stringify(plan)); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Get generated plan",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/plans/{{planId}}",
        "header": []
      }
    },
    {
      "name": "Save generated plan",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/saved-plans",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{planJson}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Saved plans",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/saved-plans",
        "header": []
      }
    },
    {
      "name": "Unsave plan",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/saved-plans/{{planId}}",
        "header": []
      }
    },
    {
      "name": "Add reflection",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/history",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"plan\": {{planJson}}, \"completedAt\": \"{{completedAt}}\", \"feeling\": \"Calm\", \"observation\": \"A bird\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set(\"completedAt\", new Date().toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) pm.collectionVariables.set(\"historyId\", pm.response.json().entry.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "History",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/history",
        "header": []
      }
    },
    {
      "name": "Delete reflection",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/history/{{historyId}}",
        "header": []
      }
    },
    {
      "name": "Export database state",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/state",
        "header": []
      }
    },
    {
      "name": "Replace database snapshot (replaces saved data)",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/state",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"preferences\": {\n    \"name\": \"Anushka\",\n    \"area\": \"Central Jaipur\",\n    \"minutes\": 20,\n    \"mood\": \"Quiet\",\n    \"budget\": \"Free\",\n    \"request\": \"A calm outdoor break\"\n  },\n  \"plans\": [],\n  \"history\": []\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Clear data (deletes saved data)",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/data",
        "header": []
      }
    }
  ]
}