HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/breaktrail.sqlite
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:3001,http://127.0.0.1:3001
OLLAMA_BASE_URL=http://127.0.0.1:11434
